{
  "name": "today-focus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/bear-personality.test.ts tests/classification.test.ts tests/korean-line-break.test.ts tests/korean-vocative.test.ts tests/leaderboard-period.test.ts tests/multi-date.test.ts tests/rate-limit.test.ts tests/recommendation.test.ts tests/share-reuse.test.ts tests/stone-achievements.test.ts tests/stone-catalog.test.ts tests/task-reason.test.ts tests/task-schedule.test.ts tests/task-suggestions.test.ts tests/today-mood.test.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:load": "node scripts/load-test.mjs",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/gaegu": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.4",
    "vite": "8.0.13",
    "wrangler": "^4.118.0"
  },
  "type": "module",
  "displayName": "오늘 뭐하지"
}
